<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="TipCalculatorController" alignment="CENTER" spacing="10" prefWidth="300" prefHeight="350">
    <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
    <Label text="Tip Calculator" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Bill Amount:"/>
    <TextField fx:id="billAmountField" promptText="Enter bill amount"/>
    <Label text="Tip Percentage:"/>
    <TextField fx:id="tipPercentageField" promptText="Enter tip %"/>
    <Button text="Calculate Tip" onAction="#calculateTip"/>
    <Button text="Reset" onAction="#reset"/>
    <Label fx:id="tipAmountLabel" text="Tip Amount: "/>
    <Label fx:id="errorLabel" text="" style="-fx-text-fill: red;"/>
</VBox>
